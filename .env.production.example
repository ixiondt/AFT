# /opt/apps/aft/.env on the droplet.
# Copy this file there, fill in the secrets, chmod 600.

# Database — host Postgres reached from rootless Podman container.
# Create with: sudo -u postgres psql -c "CREATE DATABASE db_aft;"
#              sudo -u postgres psql -c "CREATE USER aft_user WITH PASSWORD '...';"
#              sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE db_aft TO aft_user;"
DATABASE_URL=postgres://aft_user:CHANGE_ME@host.containers.internal:5432/db_aft

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
AUTH_URL=https://aft.guardcybersolutionsllc.com

# Groq narrative layer (optional). Plan still generates without this.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Logging
LOG_LEVEL=info
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
