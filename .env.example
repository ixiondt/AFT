# Postgres (local dev via Podman compose.yaml)
DATABASE_URL=postgres://aft:aft_dev_password@localhost:5433/aft

# Auth.js
# Generate with: openssl rand -base64 32  (or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
AUTH_SECRET=change_me_use_openssl_rand_base64_32
AUTH_URL=http://localhost:3000

# Groq (LLM narrative layer — optional; plan still generates deterministically without it)
# Get a key at https://console.groq.com — free tier is plenty for personal use.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Logging
LOG_LEVEL=debug
NODE_ENV=development

# Privacy
NEXT_TELEMETRY_DISABLED=1
